# Copy this file to .env and fill in your Spotify dev app credentials.
# Get these at https://developer.spotify.com/dashboard
# Redirect URI must be added there EXACTLY as below.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:9000/api/spotify/callback

# Optional overrides — defaults are fine for local dev
LAN_PORT=9000
APP_VERSION=0.1.0
# APP_DATA_DIR=/custom/path/for/db-and-logs
